# Frontend runtime config. Copy to `.env` for local dev (`.env` is gitignored).
# Vite exposes only vars prefixed with VITE_ to the client.

# Backend API base. In dev this is the RELATIVE "/api/v1" so the browser talks
# same-origin and Vite proxies it to the backend (see vite.config.js) — no CORS.
# Point it at an absolute URL (https://host/api/v1) when not using the proxy.
# (VITE_API_URL is the legacy name; src/services/api.js accepts both.)
VITE_API_BASE_URL=/api/v1

# Dev auth: identity token exchanged at /auth/session for a backend session token.
# The backend dev provider treats this bearer AS the founder's user_id UUID; this
# default is the built-in dev founder (dev@ally.local). Becomes a Supabase JWT
# when AUTH_PROVIDER=supabase.
VITE_DEV_FOUNDER_TOKEN=00000000-0000-0000-0000-000000000001

# Dev-only: which report the report screen loads until real routing / a
# "latest report" lookup exists. Matches the seeded dev fixture.
VITE_DEV_REPORT_ID=25
