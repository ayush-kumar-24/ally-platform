# Frontend runtime config. Copy to `.env` for local dev (`.env` is gitignored).
# Vite exposes only vars prefixed with VITE_ to the client.

# Backend API base (FastAPI, routes live under /api/v1).
VITE_API_URL=http://localhost:8000/api/v1

# Dev auth: the backend's dev provider treats the bearer token AS the founder's
# user_id UUID. This default is the backend's built-in dev founder
# (dev@ally.local). Point it at a real founders.user_id to load that founder.
# Replaced by a real Supabase JWT when AUTH_PROVIDER=supabase.
VITE_DEV_FOUNDER_TOKEN=00000000-0000-0000-0000-000000000001
