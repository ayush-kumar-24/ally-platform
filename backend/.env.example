# Copy to .env and fill in. Never commit the filled-in version.
#
# THIS BACKEND READS EXACTLY ONE ENVIRONMENT FILE: backend/.env, found from the
# code's own location, so it is the same file whether you start uvicorn from
# backend/, from the repository root, or from inside a container.
#
# Any other .env.* next to it -- .env.rds, .env.bak_OCR, .env.local, .env.prod --
# is INERT. Nothing in this repository opens them. They are not fallbacks and
# not profiles: the only way one takes effect is a human copying it over .env.
# Boot logs an `env_files_ignored` warning naming every one it finds, so a
# stale alternate cannot quietly look like live configuration. Keep one if it
# is a deliberate archive; otherwise delete it.
#
# The exception is this file, .env.example, which is committed as the
# documentation of every supported variable and is never loaded.

ENVIRONMENT=development

# Supabase -> Project Settings -> Database -> Connection string (URI), psycopg driver.
# Use the TRANSACTION-mode pooler, port 6543 -- not 5432.
#
# Port 5432 is session mode and the whole project gets 15 connections, shared
# by every process. This app can ask for 15 on its own, so a second process
# starves and requests block waiting for a connection -- which feels like the
# app being slow, not like an error. Port 6543 borrows a connection per
# transaction and hands it straight back.
#
# The code disables psycopg3's prepared statements automatically when it sees
# :6543 -- a transaction pooler hands out a different backend per transaction,
# and a statement prepared on one is not there on the next.
#
# If this says :5432 on a *.pooler.supabase.com host, the app moves it to 6543
# for its own engine at startup and logs
# `database_url_moved_to_transaction_pooler` -- session mode is what dropped
# three of ten end-to-end runs mid-request. Fix the port here so it stops
# needing to. Migrations are NOT moved: alembic uses this value as written,
# which is the mode Supabase wants for DDL. DB_SESSION_POOLER_OK=true turns the
# move off. Only pooler hosts are touched; a direct or RDS endpoint on 5432 is
# left exactly as written.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<host>:6543/postgres

# "dev" accepts any request as a fixed test founder. Refused when ENVIRONMENT=production.
# "supabase" verifies the JWT the frontend receives from Supabase Auth.
AUTH_PROVIDER=dev

# Required when AUTH_PROVIDER=supabase.
#
# SUPABASE_URL is the one that matters: Supabase signs user access tokens with
# ES256 and publishes the public key at {SUPABASE_URL}/auth/v1/.well-known/jwks.json,
# so this is what verifies a real Google/LinkedIn login. No shared secret needed.
# Supabase -> Project Settings -> API -> Project URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# The LEGACY shared HS256 secret. Only older projects sign user tokens with it;
# kept as a fallback. Safe to leave blank on a project using ES256.
# Supabase -> Project Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=

# Any long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Production also needs the marketing site -- the landing page help widget
# calls the public support endpoint from there.
#
# ALSO NEEDS THE WAITLIST SITE. POST /api/v1/waitlist is called by the
# registration form on the waitlist site, from the browser, so that origin must
# be listed here or every submission is blocked by CORS before it arrives. Add
# whichever host actually serves the form -- the app refers to it as
# join.goxlally.ai, while VITE_WAITLIST_URL defaults to www.goxlally.ai, and
# only one of those is real. An origin missing here fails silently in the
# browser console, not in this API's logs.
CORS_ORIGINS=http://localhost:3000,https://app.goxlally.ai,https://goxlally.ai,https://www.goxlally.ai,https://join.goxlally.ai

# --- Waitlist (registration -> admin approval -> access) ---
# The SERVICE ROLE key from Supabase -> Project Settings -> API. Used for
# exactly one call: creating the auth.users row when an admin approves a
# registration, which is the only way an identity comes into existence while
# sign-ups are switched off at the project level.
#
# THIS KEY BYPASSES ROW LEVEL SECURITY ON EVERY TABLE. Put it in Secrets
# Manager, never in a plain environment variable, and never anywhere the
# frontend can read it. Leave it empty and approving refuses outright rather
# than marking someone approved who then cannot log in.
SUPABASE_SERVICE_ROLE_KEY=

# How many founders this phase opens to. Counted against APPROVALS, not
# registrations -- the queue keeps growing past it, which is the demand signal.
# At the cap, admins are refused and a super admin can still approve
# deliberately.
WAITLIST_APPROVAL_CAP=300

# --- Discovery calls / Google Calendar ---
# Leave blank to run in stub mode (deterministic slots, placeholder meeting links).
# To go live: enable the Calendar API in Google Cloud, create a service account,
# share the host calendar with the service account's email, and paste values here.
#   GOOGLE_CALENDAR_ID: the host calendar id (e.g. team@goxl.in or the calendar's id)
# Provide the service-account key ONE of two ways -- FILE is far easier (the key
# is multi-line JSON, which .env cannot store inline):
#   GOOGLE_CALENDAR_CREDENTIALS_FILE  = google-credentials.json   (recommended; save the key file next to this)
#   GOOGLE_CALENDAR_CREDENTIALS_JSON  = {"type":"service_account",...}   (must be ONE line)
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_CREDENTIALS_JSON=
DISCOVERY_CALL_DURATION_MINUTES=45
DISCOVERY_TIMEZONE=Asia/Kolkata

# --- Email (SMTP) ---
# Leave EMAIL_HOST blank to run in stub mode (emails are logged, not sent).
# Works with any SMTP provider: Gmail (smtp.gmail.com:587 + app password),
# SendGrid, Amazon SES, Postmark, etc.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Same address founders reply to. EMAIL_PASSWORD must be a key from the
# Resend account that owns goxlally.ai (the one sending login codes).
EMAIL_FROM=Ally by GoXL <info@goxlally.ai>
EMAIL_USE_TLS=true
# Where replies land. From is no-reply, but the call emails invite a reply.
EMAIL_REPLY_TO=info@goxlally.ai
# Who is emailed when a Privacy Center request needs a human.
# Comma-separated. Falls back to EMAIL_REPLY_TO when blank.
PRIVACY_ALERT_EMAILS=
# Who is emailed when a founder sends feedback or a support message.
# Falls back to PRIVACY_ALERT_EMAILS, then EMAIL_REPLY_TO.
SUPPORT_ALERT_EMAILS=

SENTRY_DSN=
LOG_LEVEL=INFO

# --- Diagnosis reasoning LLM (Claude Sonnet 5) ------------------------------
# The diagnosis pipeline's answer classifier (Green/Amber/Red scoring of free-text
# founder answers) can run on Claude instead of stored scores. Set these four to
# turn it on. Leave ANSWER_CLASSIFIER unset/"stored" to keep the deterministic path.
# (This is the DIAGNOSIS path only -- the chat/ally LLM stack is configured separately.)
ANSWER_CLASSIFIER=stored          # set to "llm" to use Claude for answer scoring
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=                 # your Anthropic secret key -- put the real value in .env, never here
# ANTHROPIC_VERSION / ANTHROPIC_BASE_URL have working defaults; override only if needed.
# LLM_CLASSIFIER_MAX_RETRIES=2 / LLM_CLASSIFIER_TIMEOUT_SECONDS=30 also have defaults.
#
# Adaptive questioning (Hybrid): when true, the live answer-submit path uses the LLM
# to read each answer, score it, and pick the most informative next question (falls
# back to the deterministic order on any error). Keep ANSWER_CLASSIFIER=stored when
# this is on -- the submit-time scores are reused by the reasoning pipeline.
#
# !! THESE TWO FLAGS ARE COUPLED. AT LEAST ONE MUST SCORE ANSWERS. !!
#
# ADAPTIVE_QUESTIONS=true is the ONLY thing that writes answers.score_label, and
# ANSWER_CLASSIFIER=llm is the ONLY thing that derives a band at report time. With
# ADAPTIVE_QUESTIONS=false AND ANSWER_CLASSIFIER=stored -- the pair these defaults
# used to form -- every answer reaches the reasoning pipeline unscored, every one
# is skipped as unclassifiable, and the diagnosis produces a report with no root
# causes and no findings in it. That was silent: no exception, no error log, a 200
# response, and a founder who answered thirty questions reading an empty report.
#
# The pipeline now refuses to persist such a report (NoClassifiableAnswersError)
# and app/main.py logs `diagnosis_scoring_disabled` at ERROR on boot, so the
# misconfiguration is loud in both places rather than invisible. The default below
# is flipped to true so a deployment that changes nothing still scores answers.
#
# Recommended production pairing: ADAPTIVE_QUESTIONS=true + ANSWER_CLASSIFIER=stored.
# The advisor scores each answer once at submit time and the pipeline reuses it.
# Setting BOTH to their LLM values classifies every answer twice -- it works, but
# it costs 30 extra provider calls per diagnosis for labels already in the database.
ADAPTIVE_QUESTIONS=true            # set to "false" ONLY with ANSWER_CLASSIFIER=llm
# ADAPTIVE_SHORTLIST_SIZE=8 / ADAPTIVE_TIMEOUT_SECONDS=20 have defaults.

# --- Chat / Ally LLM stack (OpenAI) -----------------------------------------
# Separate from the diagnosis path above: powers the /chat endpoints (general
# chat + the legacy /ally/chat orchestrator). Decision: chat runs on OpenAI, not
# Anthropic. Falls back to anthropic (reusing ANTHROPIC_API_KEY above) then to
# the offline mock provider if OpenAI is unavailable -- never fails closed.
ALLY_LLM_PROVIDER=openai
ALLY_LLM_FALLBACK=anthropic
OPENAI_API_KEY=                    # your OpenAI secret key -- put the real value in .env, never here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL / ALLY_LLM_TIMEOUT / ALLY_LLM_MAX_RETRIES / ALLY_LLM_TEMPERATURE have defaults.

# --- Plan enforcement (chat token/credit gate) --------------------------------
# Defaults to true in code (app/core/config.py) as of 2026-08-16 -- with it
# false, chat LLM usage is completely unbounded per founder. Leave unset (or
# explicitly true) in every real deployment; only set to false for a specific
# local/offline scenario that genuinely needs unmetered chat.
# PLAN_ENFORCEMENT_ENABLED=true

# --- Semantic retrieval (RAG) ------------------------------------------------
# Off until the embedded tables (root_causes, problems, questions, rag_chunks, ...)
# actually have vectors -- turning this on against an empty/partial corpus just
# means every search returns nothing, not an error. Once populated, this powers
# BOTH chat's "retrieved knowledge" block and the diagnosis root-cause engine's
# semantic enrichment (see reasoning/deps.py::_build_enricher).
RETRIEVAL_ENABLED=false
EMBEDDING_PROVIDER=            # openai | gemini -- leave blank to keep retrieval off
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536       # must match the embedding column width, or search fails loudly
# RETRIEVAL_TOP_K=5 / RETRIEVAL_MIN_SIMILARITY=0.0 have defaults.

# --- Chat attachment storage -------------------------------------------------
# Where uploaded chat files are kept. Blank bucket (the default) stores the
# bytes inline in file_uploads.content, which is what local dev and CI run on --
# attachments work and are fully testable with no AWS access at all.
#
# Set the bucket in production and NEW uploads go to S3 instead; rows written
# before that keep resolving from Postgres, so switching over needs no backfill
# and no flag day (storage location is recorded per row, see
# app/ai_chat/attachments/storage.py).
#
# Credentials are deliberately NOT configured here -- boto3 resolves them from
# the standard chain (the ECS task role in production), so no S3 secret ever
# lives in env or in this repo. The task role needs GetObject/PutObject/
# DeleteObject on arn:aws:s3:::<bucket>/attachments/*.
#
# NOTE: if the role lacks those permissions nothing appears broken -- the put
# fails, is logged as "attachments: S3 put failed; storing inline instead", and
# the upload falls back to Postgres. Check for that line to confirm S3 is live.
ATTACHMENT_S3_BUCKET=          # e.g. goxl-ally-prod-storage -- blank = store inline
ATTACHMENT_S3_REGION=          # e.g. ap-south-1
# ATTACHMENT_S3_ENDPOINT_URL= only for S3-compatible stores (MinIO/LocalStack).

# --- Internal job sweeps -----------------------------------------------------
# Shared secret for the X-Internal-Secret header on:
#   POST /api/v1/internal/jobs/reconcile-reports      -- completed diagnoses that
#                                                        never produced a report
#   POST /api/v1/internal/jobs/backfill-report-pdfs   -- report PDFs a founder was
#                                                        told would be ready shortly
#   POST /api/v1/internal/jobs/process-deletions      -- due account erasures
#
# Left unset (the code default) every one of these returns "Internal jobs not
# configured" and NO sweep can run -- including the one a founder is waiting on
# after a 503 from the PDF export. This file omitting it is why local
# environments never had one. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_JOBS_SECRET=

# --- Invoices / receipts -----------------------------------------------------
# What a founder downloads after paying (GET /api/v1/payments/invoices/{id}/pdf).
# The document is rendered by the SAME Gotenberg sidecar the report PDF uses, so
# with no Gotenberg reachable this endpoint 503s exactly as report export does.
#
# INVOICE_SELLER_GSTIN IS THE SWITCH THAT DECIDES WHAT THE DOCUMENT IS:
#   unset  -> a PAYMENT RECEIPT. No tax breakdown, and it says in words that it
#             is not a tax invoice and that no GST is claimable against it.
#   set    -> a TAX INVOICE. GST at INVOICE_GST_PERCENT is backed OUT of the
#             amount charged (the founder was charged a gross figure, so the tax
#             is found inside it, never added on top), and the SAC code 998314
#             is printed.
# Leaving it unset is the safe default: a GST split shown without a registration
# number looks claimable and is not.
INVOICE_SELLER_NAME=GoXL Ally
INVOICE_SELLER_ADDRESS=        # one line, printed under the name
INVOICE_SELLER_EMAIL=          # e.g. billing@goxlally.ai
INVOICE_SELLER_GSTIN=          # blank = issue payment receipts, not tax invoices
INVOICE_SELLER_STATE=          # e.g. Karnataka -- blank names no place of supply
INVOICE_GST_PERCENT=18.0       # ignored entirely when no GSTIN is set
INVOICE_NUMBER_PREFIX=ALLY     # document numbers read ALLY/2026/000123
