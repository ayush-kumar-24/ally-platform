# --- Secrets (NEVER commit) ---
.env
.env.*
!.env.example

# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- User-uploaded runtime files (local-disk avatar storage; never source) ---
backend/uploads/

# --- Node / frontend ---
node_modules/
dist/
build/
.next/
*.local

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Google service-account key -- never commit
google-credentials.json
*service-account*.json
*-credentials.json
ally-platform-*.json

# Reticle agent skills (installed per-developer via `npx skills add reticlehq/reticle`).
# Not committed: they are a local tool, not project source, and .claude/skills/ holds
# symlinks that would not resolve on another machine.
.agents/
.claude/skills/
skills-lock.json

# Written beside the reference dump by scripts/dump_reference_data.py --write.
# Untracked on purpose: it carries a generated_at timestamp, so committing it
# would produce a diff on every dump even when not one row has changed -- the
# exact noise the dump is written to avoid.
backend/data/reference/manifest.json

# One-off transcripts written by scripts/e2e_journey_check.py --json-out and the
# markdown built from them. They are a record of a single run against a single
# throwaway founder, so they go stale the moment the question bank changes.
backend/*-diagnosis-transcript.md
backend/*-diagnosis-comparison.pdf
